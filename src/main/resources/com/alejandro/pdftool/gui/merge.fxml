<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alejandro.pdftool.gui.views.MergeController">
    <VBox spacing="16" styleClass="page">
        <VBox spacing="4">
            <Label styleClass="view-title" text="Unir PDF"/>
            <Label styleClass="view-description" wrapText="true"
                   text="Combina varios PDF en uno solo. Puedes añadir carpetas enteras: se incluyen sus PDF ordenados por nombre (doc2 antes que doc10)."/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="1. Archivos que quieres unir"/>
            <fx:include fx:id="files" source="file-list.fxml"/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="2. Dónde guardar el resultado"/>
            <fx:include fx:id="output" source="file-field.fxml"/>
        </VBox>
        <fx:include fx:id="runBar" source="run-bar.fxml"/>
    </VBox>
</ScrollPane>
