<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alejandro.pdftool.gui.views.EncryptController">
    <VBox spacing="16" styleClass="page">
        <VBox spacing="4">
            <Label styleClass="view-title" text="Protect with password"/>
            <Label styleClass="view-description" wrapText="true"
                   text="Encrypt the PDF with AES-256 and choose what people who open it can do. The original is not changed."/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="1. PDF"/>
            <fx:include fx:id="input" source="file-field.fxml"/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="2. Passwords"/>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="250"/>
                    <ColumnConstraints minWidth="200" prefWidth="260"/>
                    <ColumnConstraints minWidth="200" prefWidth="260"/>
                </columnConstraints>
                <Label styleClass="field-label" text="To open the document (optional):" GridPane.rowIndex="0"/>
                <PasswordField fx:id="userPassword" promptText="Password" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <PasswordField fx:id="userPasswordRepeat" promptText="Repeat it" GridPane.columnIndex="2"
                               GridPane.rowIndex="0"/>
                <Label styleClass="field-label" text="Owner (required):" GridPane.rowIndex="1"/>
                <PasswordField fx:id="ownerPassword" promptText="Password" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <PasswordField fx:id="ownerPasswordRepeat" promptText="Repeat it" GridPane.columnIndex="2"
                               GridPane.rowIndex="1"/>
            </GridPane>
            <Label styleClass="field-hint" wrapText="true"
                   text="If you set an open password, it will be required to view the PDF. The owner password lets you change permissions or remove protection: keep it somewhere safe."/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="3. What people opening the PDF can do"/>
            <FlowPane fx:id="permissionsPane" hgap="16" vgap="10"/>
            <Label styleClass="field-hint" text="Anything you leave unchecked will be blocked (accessibility reading is always allowed)."
                   wrapText="true"/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="4. Where to save the protected PDF"/>
            <fx:include fx:id="output" source="file-field.fxml"/>
        </VBox>
        <fx:include fx:id="runBar" source="run-bar.fxml"/>
    </VBox>
</ScrollPane>
