<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alejandro.pdftool.gui.views.InfoController">
    <VBox spacing="16" styleClass="page">
        <VBox spacing="4">
            <Label styleClass="view-title" text="Info &amp; metadata"/>
            <Label styleClass="view-description" wrapText="true"
                   text="View a PDF’s details and change its title, author, subject and keywords (shown by viewers and search tools)."/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="1. PDF"/>
            <fx:include fx:id="input" source="file-field.fxml"/>
            <Label fx:id="loadStatus" styleClass="field-hint"/>
        </VBox>
        <VBox fx:id="detailsBox" spacing="16">
            <VBox spacing="10" styleClass="section">
                <Label styleClass="section-label" text="2. Document"/>
                <HBox spacing="24">
                    <GridPane hgap="16" styleClass="info-grid" vgap="8" HBox.hgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label styleClass="info-key" text="Pages" GridPane.rowIndex="0"/>
                        <Label fx:id="pagesValue" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label styleClass="info-key" text="Page size" GridPane.rowIndex="1"/>
                        <Label fx:id="pageSizeValue" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label styleClass="info-key" text="File size" GridPane.rowIndex="2"/>
                        <Label fx:id="fileSizeValue" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label styleClass="info-key" text="Version" GridPane.rowIndex="3"/>
                        <Label fx:id="versionValue" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label styleClass="info-key" text="Security" GridPane.rowIndex="4"/>
                        <Label fx:id="securityValue" styleClass="info-value" wrapText="true" GridPane.columnIndex="1"
                               GridPane.rowIndex="4"/>
                        <Label styleClass="info-key" text="Created with" GridPane.rowIndex="5"/>
                        <Label fx:id="creatorValue" styleClass="info-value" wrapText="true" GridPane.columnIndex="1"
                               GridPane.rowIndex="5"/>
                        <Label styleClass="info-key" text="Produced by" GridPane.rowIndex="6"/>
                        <Label fx:id="producerValue" styleClass="info-value" wrapText="true" GridPane.columnIndex="1"
                               GridPane.rowIndex="6"/>
                        <Label styleClass="info-key" text="Created" GridPane.rowIndex="7"/>
                        <Label fx:id="createdValue" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        <Label styleClass="info-key" text="Last modified" GridPane.rowIndex="8"/>
                        <Label fx:id="modifiedValue" styleClass="info-value" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                    </GridPane>
                    <StackPane minWidth="160" styleClass="thumbnail-frame" maxHeight="-Infinity" maxWidth="-Infinity">
                        <ImageView fx:id="coverView" fitHeight="210" fitWidth="150" pickOnBounds="true" preserveRatio="true"/>
                    </StackPane>
                </HBox>
            </VBox>
            <VBox spacing="10" styleClass="section">
                <Label styleClass="section-label" text="3. Metadata (you can change it)"/>
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label styleClass="field-label" text="Title:" GridPane.rowIndex="0"/>
                    <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label styleClass="field-label" text="Author:" GridPane.rowIndex="1"/>
                    <TextField fx:id="authorField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label styleClass="field-label" text="Subject:" GridPane.rowIndex="2"/>
                    <TextField fx:id="subjectField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label styleClass="field-label" text="Keywords:" GridPane.rowIndex="3"/>
                    <TextField fx:id="keywordsField" promptText="separated by commas" GridPane.columnIndex="1"
                               GridPane.rowIndex="3"/>
                </GridPane>
                <Label styleClass="field-hint" text="Leave a field empty to remove it."/>
            </VBox>
            <VBox spacing="10" styleClass="section">
                <Label styleClass="section-label" text="4. Where to save"/>
                <fx:include fx:id="output" source="file-field.fxml"/>
                <Label styleClass="field-hint" text="You can choose the same file to overwrite it (you’ll be asked to confirm)."/>
            </VBox>
            <fx:include fx:id="runBar" source="run-bar.fxml"/>
        </VBox>
    </VBox>
</ScrollPane>
