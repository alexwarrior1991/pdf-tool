<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Main window. Each sidebar button carries in userData the name of its screen's FXML
  (merge → merge.fxml…); the home cards use the same identifier.
-->
<BorderPane styleClass="app-root" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alejandro.pdftool.gui.MainController">
    <fx:define>
        <ToggleGroup fx:id="navigation"/>
    </fx:define>
    <left>
        <VBox prefWidth="240" styleClass="sidebar">
            <VBox spacing="2" styleClass="brand">
                <Label styleClass="brand-title" text="PDF Tool"/>
                <Label styleClass="brand-subtitle" text="Your PDFs, made simple" wrapText="true"/>
            </VBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="2" styleClass="nav">
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" selected="true" styleClass="nav-button"
                                  text="Home" toggleGroup="$navigation" userData="home"/>
                    <Label styleClass="nav-section" text="ORGANIZE"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button" text="Merge PDFs"
                                  toggleGroup="$navigation" userData="merge"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button" text="Split PDF"
                                  toggleGroup="$navigation" userData="split"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Extract or delete pages" toggleGroup="$navigation" userData="pages"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Rotate pages" toggleGroup="$navigation" userData="rotate"/>
                    <Label styleClass="nav-section" text="CONVERT"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Images to PDF" toggleGroup="$navigation" userData="images-to-pdf"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="PDF to images" toggleGroup="$navigation" userData="pdf-to-images"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Extract text" toggleGroup="$navigation" userData="text"/>
                    <Label styleClass="nav-section" text="EDIT"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button" text="Compress"
                                  toggleGroup="$navigation" userData="compress"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Watermark" toggleGroup="$navigation" userData="watermark"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Page numbers" toggleGroup="$navigation" userData="page-numbers"/>
                    <Label styleClass="nav-section" text="SECURITY"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Protect with password" toggleGroup="$navigation" userData="encrypt"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Remove password" toggleGroup="$navigation" userData="decrypt"/>
                    <Label styleClass="nav-section" text="DOCUMENT"/>
                    <ToggleButton maxWidth="Infinity" mnemonicParsing="false" styleClass="nav-button"
                                  text="Info &amp; metadata" toggleGroup="$navigation" userData="info"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="content" styleClass="content">
            <ScrollPane fx:id="home" fitToWidth="true" styleClass="page-scroll">
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="4">
                        <Label styleClass="view-title" text="What would you like to do?"/>
                        <Label styleClass="view-description" wrapText="true"
                               text="Choose a tool. On each screen you can drag files in directly or click &quot;Browse…&quot;. The original file is never changed unless you choose to overwrite it."/>
                    </VBox>

                    <Label styleClass="home-section" text="Organize"/>
                    <FlowPane hgap="14" rowValignment="TOP" vgap="14">
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="merge">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Merge PDFs" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Combine several PDFs (or whole folders) into one, in the order you choose." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="split">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Split PDF" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Split a PDF by page ranges or into parts of N pages." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="pages">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Extract or delete pages" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Keep only the pages you need, in any order, or remove the ones you don’t." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="rotate">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Rotate pages" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Straighten scanned pages that are upside down or sideways." wrapText="true"/>
                        </VBox>
                    </FlowPane>

                    <Label styleClass="home-section" text="Convert"/>
                    <FlowPane hgap="14" rowValignment="TOP" vgap="14">
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="images-to-pdf">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Images to PDF" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Turn photos and scans (JPG, PNG…) into a single PDF." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="pdf-to-images">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="PDF to images" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Save PDF pages as PNG or JPG images." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="text">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Extract text" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Copy the text from a PDF or save it to a .txt file." wrapText="true"/>
                        </VBox>
                    </FlowPane>

                    <Label styleClass="home-section" text="Edit"/>
                    <FlowPane hgap="14" rowValignment="TOP" vgap="14">
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="compress">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Compress" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Reduce the size by recompressing the PDF’s images." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="watermark">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Watermark" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Add diagonal text (DRAFT, CONFIDENTIAL…) across every page." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="page-numbers">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Page numbers" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Add “Page 1 of 10” (or any format you like) to your pages." wrapText="true"/>
                        </VBox>
                    </FlowPane>

                    <Label styleClass="home-section" text="Security and document"/>
                    <FlowPane hgap="14" rowValignment="TOP" vgap="14">
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="encrypt">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Protect with password" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Encrypt the PDF (AES-256) and choose what can be done with it." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="decrypt">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Remove password" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="Remove the protection from a PDF whose owner password you know." wrapText="true"/>
                        </VBox>
                        <VBox onMouseClicked="#openCard" spacing="4" styleClass="home-card" userData="info">
                            <Label maxWidth="Infinity" styleClass="home-card-title" text="Info &amp; metadata" wrapText="true"/>
                            <Label maxWidth="Infinity" styleClass="home-card-text" text="See pages, size and permissions, and edit title, author and keywords." wrapText="true"/>
                        </VBox>
                    </FlowPane>
                </VBox>
            </ScrollPane>
        </StackPane>
    </center>
</BorderPane>
