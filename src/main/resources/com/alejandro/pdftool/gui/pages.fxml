<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" styleClass="page-scroll" stylesheets="@app.css" xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alejandro.pdftool.gui.views.PagesController">
    <VBox spacing="16" styleClass="page">
        <fx:define>
            <ToggleGroup fx:id="mode"/>
        </fx:define>
        <VBox spacing="4">
            <Label styleClass="view-title" text="Extract or delete pages"/>
            <Label styleClass="view-description" wrapText="true"
                   text="Create a new PDF with only the pages you need (in the order you type) or without the ones you don’t. The original is not changed."/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="1. PDF"/>
            <fx:include fx:id="input" source="file-field.fxml"/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="2. Choose the pages"/>
            <HBox spacing="20">
                <RadioButton fx:id="keepMode" mnemonicParsing="false" selected="true"
                             text="Keep only these pages" toggleGroup="$mode"/>
                <RadioButton fx:id="deleteMode" mnemonicParsing="false" text="Delete these pages"
                             toggleGroup="$mode"/>
            </HBox>
            <TextField fx:id="rangesField" promptText="Click the thumbnails or type, e.g. 1-3, 7"/>
            <Label styleClass="field-hint" wrapText="true"
                   text="To extract in a different order, type it like this: 5, 1-3 (page 5 goes first)."/>
            <fx:include fx:id="thumbnails" source="thumbnails.fxml"/>
        </VBox>
        <VBox spacing="10" styleClass="section">
            <Label styleClass="section-label" text="3. Where to save the result"/>
            <fx:include fx:id="output" source="file-field.fxml"/>
            <Label styleClass="field-hint" wrapText="true"
                   text="Note: bookmarks (table of contents) and fillable forms from the original are not kept."/>
        </VBox>
        <fx:include fx:id="runBar" source="run-bar.fxml"/>
    </VBox>
</ScrollPane>
